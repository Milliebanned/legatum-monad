{
  "name": "legatum-monad",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial dead-man's-switch vault for MON and stablecoins on Monad",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run script/deploy-local.js --network localhost",
    "deploy:testnet": "hardhat run script/deploy.js --network monadTestnet",
    "keeper:testnet": "node script/keeper.js --network testnet",
    "keeper:mainnet": "node script/keeper.js --network mainnet",
    "deploy:monad": "hardhat run script/deploy.js --network monad"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^18.0.2",
    "hardhat": "^2.29.1"
  }
}
